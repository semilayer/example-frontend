# SemiLayer API — point at local dev service or the hosted SaaS
VITE_SEMILAYER_URL=https://api.semilayer.com

# Publishable key for the environment (pk_...).
# Get this from `semilayer keys create --type pk` or the Console.
VITE_SEMILAYER_KEY=pk_development_

# Lens to query (must be defined in your sl.config.ts and pushed).
VITE_SEMILAYER_LENS=recipes
